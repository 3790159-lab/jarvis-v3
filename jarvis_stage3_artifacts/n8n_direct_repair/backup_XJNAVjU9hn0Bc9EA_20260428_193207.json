                      "parameters":  {
                                         "jsCode":  "const r = ;\n\nconst lines = [];\n\nlines.push(\u0027✅ Jarvis V5 Super Hybrid Pipeline completed\u0027);\nlines.push(\u0027\u0027);\nlines.push(Run ID: );\nlines.push(Stage: );\n\nif (r.score) {\n  lines.push(Images: );\n  lines.push(Videos: );\n  lines.push(Uploaded: );\n  lines.push(Quality: );\n}\n\nif (r.image_urls \u0026\u0026 r.image_urls.length) {\n  lines.push(\u0027\u0027);\n  lines.push(\u0027Image URLs:\u0027);\n  for (const u of r.image_urls) lines.push(- );\n}\n\nif (r.drive_folder_url) {\n  lines.push(\u0027\u0027);\n  lines.push(Drive folder: );\n}\n\nif (r.local_run_dir) {\n  lines.push(\u0027\u0027);\n  lines.push(Local dir: );\n}\n\nreturn [{\n  json: {\n    ok: true,\n    final_message: lines.join(\u0027\\n\u0027),\n    result: r\n  }\n}];"
