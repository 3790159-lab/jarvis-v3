{
  "name": "telegram_bridge",
  "category": "messaging",
  "enabled": true,
  "mode": "safe_observe_and_send",
  "safe_actions": [
    "health_check",
    "send_safe_message",
    "read_bot_config"
  ],
  "blocked_actions": [
    "mass_broadcast",
    "unsafe_command_execution"
  ],
  "endpoints": [],
  "required_env_vars": [
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_ALLOWED_CHAT_ID"
  ],
  "notes": [
    "Use only controlled outbound messages and health checks at this stage."
  ]
}