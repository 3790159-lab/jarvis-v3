{
  "name": "local_http_tools",
  "category": "http",
  "enabled": true,
  "mode": "safe_local_http",
  "safe_actions": [
    "health_check",
    "local_get",
    "local_safe_post"
  ],
  "blocked_actions": [
    "arbitrary_external_post",
    "unsafe_remote_calls"
  ],
  "endpoints": [
    "http://127.0.0.1:8015/health",
    "http://127.0.0.1:8015/api/ai/health",
    "http://127.0.0.1:8015/api/autonomy/health"
  ],
  "required_env_vars": [],
  "notes": [
    "Restrict to localhost and approved endpoints only."
  ]
}