{
  "phase": 11,
  "name": "Execution Orchestrator / Mission Runner v2",
  "goals": [
    "Run mission stages step-by-step",
    "Support dispatcher-based execution",
    "Maintain live execution journal",
    "Support stop, resume and cancel",
    "Finalize runs consistently"
  ],
  "components": [
    "planner_adapter",
    "stage_dispatcher",
    "executor_runtime",
    "qa_stage",
    "journal_writer",
    "completion_reconciler"
  ],
  "api": [
    "POST /api/missions/{mission_id}/run",
    "POST /api/missions/{mission_id}/stop",
    "POST /api/missions/{mission_id}/resume",
    "POST /api/missions/{mission_id}/cancel",
    "GET /api/missions/{mission_id}/journal"
  ],
  "acceptance_criteria": [
    "Mission progresses through stages",
    "Journal is persisted",
    "Run can be stopped and resumed",
    "Completion state is consistent"
  ]
}
