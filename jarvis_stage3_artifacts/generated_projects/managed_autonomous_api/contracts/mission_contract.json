{
    "schema_version":  1,
    "entity":  "mission",
    "required_fields":  [
                            "mission_id",
                            "goal_id",
                            "objective",
                            "status",
                            "created_at",
                            "updated_at",
                            "tasks"
                        ],
    "optional_fields":  [
                            "constraints",
                            "summary",
                            "result",
                            "error",
                            "metadata"
                        ],
    "allowed_statuses":  [
