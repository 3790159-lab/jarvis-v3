{
    "schema_version":  1,
    "entity":  "task",
    "required_fields":  [
                            "task_id",
                            "mission_id",
                            "title",
                            "type",
                            "status",
                            "created_at",
                            "updated_at"
                        ],
    "optional_fields":  [
                            "agent",
                            "input",
                            "result",
                            "error",
                            "attempt_count",
                            "max_attempts",
                            "depends_on",
                            "metadata"
                        ],
    "allowed_statuses":  [
                             "queued",
                             "running",
                             "completed",
                             "failed",
                             "skipped",
                             "waiting_input",
                             "cancelled"
                         ]
}
