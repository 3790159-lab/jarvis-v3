# Jarvis Smart Telegram — .env template
# Copy this to .env and fill in your values.
# IMPORTANT: Backend runs on port 8010. Both URL vars must match.

APP_HOST=127.0.0.1
APP_PORT=8010

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=<your_bot_token>
TELEGRAM_ALLOWED_CHAT_ID=<your_chat_id>
TELEGRAM_BACKEND_URL=http://127.0.0.1:8010
TELEGRAM_POLL_INTERVAL_SECONDS=3
TELEGRAM_WAIT_FOR_COMPLETION_SECONDS=60

# ── Backend URL (MUST match APP_PORT = 8010) ──────────────────────────────────
BACKEND_BASE_URL=http://127.0.0.1:8010
JARVIS_BASE_URL=http://127.0.0.1:8010

# ── AI Providers ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-...
PERPLEXITY_API_KEY=pplx-...
TAVILY_API_KEY=tvly-...

AI_ROUTER_ENABLE_OPENAI=true
AI_ROUTER_ENABLE_ANTHROPIC=true
AI_ROUTER_ENABLE_OLLAMA=true
AI_ROUTER_OPENAI_MODEL=gpt-4.1
AI_ROUTER_ANTHROPIC_MODEL=claude-sonnet-4-5
AI_ROUTER_OLLAMA_MODEL=llama3.1:latest

# ── Ollama (local) ────────────────────────────────────────────────────────────
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_SECONDS=9

# ── n8n ───────────────────────────────────────────────────────────────────────
N8N_BASE_URL=https://your.n8n.cloud
N8N_API_KEY=<your_n8n_api_key>
JARVIS_N8N_ENABLED=true
JARVIS_N8N_MODE=webhook
JARVIS_N8N_BASE_URL=http://127.0.0.1:5678
JARVIS_N8N_HEALTH_URL=http://127.0.0.1:5678/healthz
JARVIS_N8N_TRIGGER_PATH=/webhook/jarvis/inbox_v2
JARVIS_N8N_SHARED_KEY=<random_secret>

# ── Google (optional) ─────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service_account.json
GOOGLE_OAUTH_CLIENT_SECRET_JSON=path/to/client_secret.json
GOOGLE_OAUTH_TOKEN_JSON=state/google_oauth_token.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Europe/Kyiv

# ── Obsidian (optional) ───────────────────────────────────────────────────────
JARVIS_OBSIDIAN_VAULT_PATH=C:\Users\YourName\Documents\JarvisVault

# ── Image generation (optional) ───────────────────────────────────────────────
INFLUENCER_API_KEY=<your_key>
INFLUENCER_BASE_URL=https://influencerstudio.com/api/v1
INFLUENCER_WORKSPACE_ID=<workspace_id>
INFLUENCER_ID=<influencer_id>

# ── Misc ──────────────────────────────────────────────────────────────────────
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
LOG_LEVEL=INFO
CACHE_ENABLED=true
CACHE_MAX_ITEMS=200
CACHE_TTL_SECONDS=300
