APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8017

EXECUTION_MODE=real
MAX_CONCURRENT_TASKS=4
TASK_DEFAULT_TIMEOUT_SECONDS=90
TASK_MAX_RETRIES=2
TASK_RETRY_BACKOFF_SECONDS=1.5

HTTP_DEFAULT_TIMEOUT_SECONDS=45
HTTP_VERIFY_SSL=true

LOG_LEVEL=INFO

PROJECT_ROOT=
ARTIFACTS_DIR=jarvis_stage3_artifacts

N8N_BASE_URL=http://127.0.0.1:5678
N8N_DEFAULT_WEBHOOK_PATH=/webhook/jarvis-stage3

LLM_MODE=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.2:latest
LLM_TIMEOUT_SECONDS=180

ALLOWED_SHELL_COMMANDS=python,py,pip,uvicorn,git,echo,dir,type,powershell,pwsh,Get-ChildItem,Get-Content,Invoke-RestMethod,Test-NetConnection,cmd
BLOCKED_SHELL_PATTERNS=del ,rm ,shutdown,format ,diskpart,reg delete,rmdir /s,Remove-Item -Recurse,Remove-Item -Force
