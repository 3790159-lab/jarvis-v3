.venv/
__pycache__/
.pytest_cache/
*.pyc
*.pyo
.env
*.log
node_modules/
.DS_Store

# RunPod secrets
.env.runpod

# Phase 2 additions
state/
logs/
.env.backup_*
.env.before_*
*.before_*
backup_*/
backup_*.py
# DEV-46: правило выше — для СЛУЧАЙНЫХ локальных копий скриптов, но по ИМЕНИ
# оно глотает и настоящие исходники. За одну ночь съело два файла арки:
# app/services/backup_crypto.py и scripts/backup_keygen.py. Оба лежали на
# диске, сторожа по ним зеленели, git status их не показывал — мерж уехал бы
# БЕЗ модуля шифрования и без генератора ключа, и обнаружилось бы это на
# деплое. Молча.
#
# Поэтому исключение не точечное, а по каталогам ИСХОДНИКОВ: случайные копии
# скриптов туда не попадают, они падают в корень и в черновики. Сужать само
# правило нельзя — оно ловит настоящий мусор.
#
# Сторож на весь класс: tests/test_source_files_are_tracked.py — требует,
# чтобы ни один .py в app/ chatter/ scripts/ tools/ не был невидим для git.
!app/**/backup_*.py
!chatter/**/backup_*.py
!scripts/backup_*.py
!tools/backup_*.py
backup_*.env
.claude/
creds/
*_oauth_token*.json
*.pid
bot_heartbeat.txt

# Block M.2 smoke test fixtures and local run logs
data/test_inputs/
scripts/smoke_test_*.log
scripts/runpod_recreate_*.log

# --- Phase 3 additions (May 20, 2026) ---

# Env-variant backups missed by existing patterns
.env.*.bak_*
.env.runpod.bak_*

# Research result dumps (non-source artifacts)
jarvis_stage3_artifacts/internet_tools/research_*.json

# Block M.2 video output directory (mirror of data/test_inputs/ rule)
data/block_m2_video/

# Brain / runtime state JSON shouldn't be tracked
jarvis_stage3_artifacts/telegram_smart_control/brain_v2_state.json

# Debug / scratch scripts (commit useful ones under proper names instead)
scripts/debug_*.py
scripts/_*.py

# .log.err sibling files alongside .log
scripts/*.log.err

# Nested generated-project venvs (recursive certifi/pip bloat)
jarvis_stage3_artifacts/generated_projects/*/.venv/

# scratchpad: local baseline/regress artifacts, never commit
scratchpad/

# browser-use runtime state
state/browser_profile/
state/browser_sessions/
state/browser_playbooks/

# --- Cleanup 2026-07-09: untrack runtime artifacts & close .env-backup leak ---

# Whole runtime-artifact tree is bot output, never source (supersedes narrower rules above)
jarvis_stage3_artifacts/

# .env backups missed by existing patterns (contain real tokens — keep on disk, never commit)
.env.backup
.env.bak_*

# Misc local backups / runtime data dirs
requirements_backup_*
data/block_m2_face_swap/

# --- CHATTER-2 arc 2 (Milestone F): Telethon session = full account access ---
/.secrets/

# chatter config versions (created at runtime, never commit)
chatter/clients/*/.versions/

# --- Secrets blanket 2026-07-24: catch-all, не по одному файлу ---
# Повод: .env.enc лежал untracked И не в .gitignore — один `git add .` и
# зашифрованный конфиг уехал бы в историю навсегда.
# Правило: всё семейство .env — под запретом, .example/.stage3 возвращаем явно.
.env.*
!.env.example
!.env.runpod.example
!.env.stage3

# Ключевой материал и сессии — где бы ни лежали (не только в /.secrets/)
entropy.bin
*.session
*.session-journal
*.key
*.pem

# Платёжные реквизиты клиентов — где бы ни лежали (маска, не один путь).
# Это ЧУЖИЕ банковские данные: ошибка в одном символе IBAN означает деньги,
# ушедшие не туда, а утечка в публичную историю не отзывается никогда.
# Шаблон с инструкцией по заполнению — requisites.example.yaml, он трекается.
requisites.yaml
!requisites.example.yaml

# Резервные копии Jarvis (могут содержать .env целиком)
*.jrvbak

# Пробы секретов (state/ уже игнорируется, дублируем на случай переезда)
secrets_probe
secrets_probe.*

# --- Онбординг клиента (chatter.onboard): выход пайплайна ---
# `build/onboard/<slug>/` держит brief.json — а это имя клиента, его контакты
# и ВНУТРЕННИЕ цены, взятые из брифа дословно. Первый же `git add .` утащил бы
# чужие персональные данные в историю, откуда они не отзываются.
# Закрываем весь `build/`, а не один путь: маска дешевле, чем перечень,
# и переезд каталога сборки её не обходит.
build/
